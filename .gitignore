# ── Swift Package Manager ────────────────────────────────────────────────
.build/
Packages/
Package.pins
Package.resolved
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# ── CocoaPods ────────────────────────────────────────────────────────────
Pods/
*.podspec.json

# ── Carthage (out of scope, here for safety) ─────────────────────────────
Carthage/Build/
Carthage/Checkouts/

# ── Fastlane ─────────────────────────────────────────────────────────────
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# ── XCFramework distribution outputs ─────────────────────────────────────
dist/
Framework/
*.xcframework.zip

# ── Local config (machine-specific, NEVER commit) ────────────────────────
*.xcconfig.local

# ── Secrets / env ────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.gpg
*.asc
*.p12
*.cer
*.mobileprovision

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS junk ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Test reports / coverage ──────────────────────────────────────────────
test-results/
coverage/
*.xcresult/

# ── Generated ────────────────────────────────────────────────────────────
generated/

# ── Documentation builds (DocC, jazzy, etc.) ─────────────────────────────
docs/_build/
docs/api/  # generated DocC output (BEE-76+)
site/

# ── Node tooling (commitlint only, no runtime JS) ────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code internal state
.claude/
